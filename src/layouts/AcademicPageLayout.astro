---
import AcademicShell from "../components/AcademicShell.astro";
import BaseLayout from "./BaseLayout.astro";
import type { AcademicConfig, IdentityConfig, Project, Publication } from "../types";
import type { MessageOverrides } from "../messages";

interface Props {
  title: string;
  description: string;
  active: "publications" | "projects" | "about";
  academic: AcademicConfig;
  identity: IdentityConfig;
  projects?: Project[];
  publications?: Publication[];
  messages?: MessageOverrides;
}

const { title, description, active, academic, identity, projects = [], publications = [], messages } = Astro.props;
---

<BaseLayout title={`${title} · ${academic.title}`} description={description} lang={academic.language} pageClass="academic-page" messages={messages}>
  <slot name="head" slot="head" />
  <AcademicShell active={active} academic={academic} identity={identity} projects={projects} publications={publications} inner messages={messages}>
    <slot name="header-actions" slot="header-actions" />
    <slot name="sidebar" slot="sidebar" />
    <slot name="footer-extra" slot="footer-extra" />
    <slot />
  </AcademicShell>
</BaseLayout>
