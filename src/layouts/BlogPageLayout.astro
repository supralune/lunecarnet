---
import BlogShell from "../components/BlogShell.astro";
import { templatePath } from "../config/runtime";
import BaseLayout from "./BaseLayout.astro";
import type { Post } from "../lib/posts";
import type { BlogConfig, IdentityConfig } from "../types";
import type { MessageOverrides } from "../messages";

interface Props {
  title: string;
  description: string;
  active: "archive" | "categories" | "about" | "search";
  posts: Post[];
  blog: BlogConfig;
  identity: IdentityConfig;
  messages?: MessageOverrides;
}

const { title, description, active, posts, blog, identity, messages } = Astro.props;
---

<BaseLayout title={`${title} · ${blog.title}`} description={description} lang={blog.language} pageClass="blog-page" feed={{ title: `${blog.title} RSS`, href: templatePath("blog", "/rss.xml") }} messages={messages}>
  <slot name="head" slot="head" />
  <BlogShell active={active} posts={posts} blog={blog} identity={identity} inner messages={messages}>
    <slot name="header-actions" slot="header-actions" />
    <slot name="sidebar" slot="sidebar" />
    <slot name="footer-extra" slot="footer-extra" />
    <slot />
  </BlogShell>
</BaseLayout>
