---
import BlogSidebar from "@/components/BlogSidebar.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import BlogHeader from "@/components/BlogHeader.astro";
import { blog } from "@/config/blog";
import { templatePath } from "@/config/runtime";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { Post } from "@/lib/posts";

interface Props {
  title: string;
  description: string;
  active: "archive" | "categories" | "about" | "search";
  posts: Post[];
}

const { title, description, active, posts } = Astro.props;
---

<BaseLayout title={`${title} · ${blog.title}`} description={description} lang={blog.language} pageClass="blog-page" feed={{ title: `${blog.title} RSS`, href: templatePath("blog", "/rss.xml") }}>
  <div class="site-shell blog-shell">
    <BlogHeader active={active} />
    <div class="page-layout">
      <main class="main-content inner-content" id="main"><slot /></main>
      <BlogSidebar posts={posts} />
    </div>
    <SiteFooter variant="blog" />
  </div>
</BaseLayout>
