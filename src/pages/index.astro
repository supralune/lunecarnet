---
import { academic } from "@/config/academic";
import { blog } from "@/config/blog";
import { templatePath } from "@/config/runtime";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBase } from "@/lib/url";
---

<BaseLayout title="Lunecarnet · Choose a template" description="Preview the standalone blog and academic website templates." pageClass="template-index-page">
  <main class="template-index" id="main">
    <header>
      <p class="eyebrow">LUNECARNET · TEMPLATE COLLECTION</p>
      <h1>Choose the site you want to explore.</h1>
      <p>Each template can run independently with clean root-level routes, or together from this combined preview.</p>
    </header>
    <div class="template-grid">
      <article>
        <p class="template-number">01 · WRITING</p>
        <h2>{blog.title}</h2>
        <p>{blog.description}</p>
        <a class="button primary" href={withBase(templatePath("blog"))}>Open blog template →</a>
      </article>
      <article>
        <p class="template-number">02 · RESEARCH</p>
        <h2>Academic profile</h2>
        <p>{academic.description}</p>
        <a class="button primary" href={withBase(templatePath("academic"))}>Open academic template →</a>
      </article>
    </div>
  </main>
</BaseLayout>
