---
import BlogPageLayout from "@/layouts/BlogPageLayout.astro";
import TemplateGuide from "@/components/TemplateGuide.astro";
import EmptyState from "@/components/EmptyState.astro";
import { formatDate, getPublishedPosts, postPath, type Post } from "@/lib/posts";
import { withBase } from "@/lib/url";

const posts = await getPublishedPosts();
const grouped = Object.entries(posts.reduce<Record<string, Post[]>>((years, post) => {
  const year = String(post.data.publishDate.getFullYear());
  (years[year] ??= []).push(post);
  return years;
}, {})).sort(([a], [b]) => Number(b) - Number(a));
---

<BlogPageLayout title="Archive" description="Browse all published notes by year." active="archive" posts={posts}>
  <header class="page-heading">
    <p class="eyebrow">ARCHIVE · {posts.length} NOTES</p>
    <h1>Archive</h1>
    <p>All notes are grouped by publication year. Dates and categories are read automatically from each Markdown file.</p>
  </header>

  <TemplateGuide title="Automatic archive">
    <p>You do not need to maintain this page manually. Add or remove files in <code>src/content/posts/</code>, and the years and entries update automatically.</p>
  </TemplateGuide>

  <div class="archive-groups">
    {grouped.length > 0 ? grouped.map(([year, yearPosts]) => (
      <section class="archive-year">
        <div class="archive-year-label"><h2>{year}</h2><span>{yearPosts.length} {yearPosts.length === 1 ? "note" : "notes"}</span></div>
        <ol>
          {yearPosts.map((post) => (
            <li>
              <time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time>
              <a href={withBase(postPath(post))}>{post.data.title}</a>
              <span>{post.data.category}</span>
            </li>
          ))}
        </ol>
      </section>
    )) : <EmptyState title="The archive is ready" description="Publish a Markdown note and this page will organize it by year automatically." />}
  </div>
</BlogPageLayout>
