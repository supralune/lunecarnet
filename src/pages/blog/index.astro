---
import BlogHome from "@/components/BlogHome.astro";
import { blog } from "@/data/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPublishedPosts } from "@/lib/posts";

const posts = await getPublishedPosts();
const siteOrigin = Astro.site ?? Astro.url.origin;
const schema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: blog.title,
  description: blog.description,
  url: new URL(import.meta.env.BASE_URL + "blog/", siteOrigin).toString()
};
---

<BaseLayout title={`${blog.title} · Blog`} description={blog.description} lang={blog.language} pageClass="blog-page" schema={schema}>
  <BlogHome posts={posts} />
</BaseLayout>
