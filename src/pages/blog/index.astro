---
import { BaseLayout, BlogHome, getPublishedPosts, templatePath } from "@lunecarnet/astro";
import { blog } from "@/config/blog";
import { blogTemplate } from "@/config/site";

const posts = await getPublishedPosts();
const siteOrigin = Astro.site ?? Astro.url.origin;
const schema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: blog.title,
  description: blog.description,
  url: new URL(import.meta.env.BASE_URL.replace(/\/$/, "") + templatePath("blog"), siteOrigin).toString()
};
---

<BaseLayout title={`${blog.title} · Blog`} description={blog.description} lang={blog.language} pageClass="blog-page" schema={schema} feed={{ title: `${blog.title} RSS`, href: templatePath("blog", "/rss.xml") }}>
  <BlogHome posts={posts} {...blogTemplate} />
</BaseLayout>
