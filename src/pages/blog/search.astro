---
import BlogPageLayout from "@/layouts/BlogPageLayout.astro";
import { getPublishedPosts, postPath } from "@/lib/posts";
import { withBase } from "@/lib/url";

const posts = await getPublishedPosts();
const searchIndex = posts.map((post) => ({
  title: post.data.title,
  description: post.data.description,
  category: post.data.category,
  tags: post.data.tags,
  date: post.data.publishDate.toISOString(),
  path: withBase(postPath(post)),
  body: post.body ?? ""
}));
const serializedIndex = JSON.stringify(searchIndex).replace(/</g, "\\u003c");
---

<BlogPageLayout title="Search" description="Search all published notes." active="search" posts={posts}>
  <header class="page-heading">
    <p class="eyebrow">SEARCH · {posts.length} NOTES</p>
    <h1>Search Notes</h1>
    <p>Search titles, summaries, categories, tags, and article text. Everything runs locally in your browser.</p>
  </header>

  <div class="search-box">
    <label class="sr-only" for="note-search">Search notes</label>
    <span class="search-symbol" aria-hidden="true">⌕</span>
    <input id="note-search" type="search" inputmode="search" autocomplete="off" placeholder="Try “design”, “learning”, or “research”…" />
    <button id="search-clear" type="button" aria-label="Clear search" hidden>Clear</button>
  </div>
  <p class="search-status" id="search-status" aria-live="polite">Start typing to search all notes.</p>
  <div class="search-results" id="search-results"></div>
  <noscript><p class="search-empty">Search requires JavaScript. You can still browse every note in the <a href={withBase("/blog/archive/")}>archive</a>.</p></noscript>
  <script is:inline id="search-index" type="application/json" set:html={serializedIndex}></script>
  <script is:inline>
    const indexElement = document.querySelector("#search-index");
    const input = document.querySelector("#note-search");
    const clearButton = document.querySelector("#search-clear");
    const status = document.querySelector("#search-status");
    const results = document.querySelector("#search-results");
    const index = JSON.parse(indexElement?.textContent || "[]");

    const normalize = (value) => value.toLowerCase().normalize("NFKD");
    const formatDate = (value) => new Intl.DateTimeFormat("en-US", { year: "numeric", month: "short", day: "numeric" }).format(new Date(value));

    const renderResults = (query) => {
      const terms = normalize(query).trim().split(/\s+/).filter(Boolean);
      results.replaceChildren();
      clearButton.hidden = terms.length === 0;

      if (!terms.length) {
        status.textContent = "Start typing to search all notes.";
        return;
      }

      const matches = index.filter((item) => {
        const haystack = normalize([item.title, item.description, item.category, ...item.tags, item.body].join(" "));
        return terms.every((term) => haystack.includes(term));
      });
      status.textContent = `${matches.length} ${matches.length === 1 ? "note" : "notes"} found for “${query.trim()}”.`;

      if (!matches.length) {
        const empty = document.createElement("p");
        empty.className = "search-empty";
        empty.textContent = "No notes matched every term. Try a broader or shorter query.";
        results.append(empty);
        return;
      }

      matches.forEach((item) => {
        const article = document.createElement("article");
        article.className = "search-result";
        const heading = document.createElement("h2");
        const link = document.createElement("a");
        link.href = item.path;
        link.textContent = item.title;
        heading.append(link);
        const excerpt = document.createElement("p");
        excerpt.textContent = item.description;
        const meta = document.createElement("p");
        meta.className = "search-result-meta";
        meta.textContent = `${formatDate(item.date)} · ${item.category}`;
        article.append(heading, excerpt, meta);
        results.append(article);
      });
    };

    const initialQuery = new URLSearchParams(location.search).get("q") || "";
    input.value = initialQuery;
    renderResults(initialQuery);
    input.addEventListener("input", () => {
      renderResults(input.value);
      const url = new URL(location.href);
      input.value.trim() ? url.searchParams.set("q", input.value.trim()) : url.searchParams.delete("q");
      history.replaceState({}, "", url);
    });
    clearButton.addEventListener("click", () => {
      input.value = "";
      renderResults("");
      history.replaceState({}, "", location.pathname);
      input.focus();
    });
  </script>
</BlogPageLayout>
