---
import { BlogArchiveYearPage, getBlogArchiveYearPaths, getPublishedPosts } from "@lunecarnet/astro";
import { blogTemplate } from "@/config/site";
export function getStaticPaths() { return getBlogArchiveYearPaths(); }
const posts = await getPublishedPosts();
const { year } = Astro.props;
---
<BlogArchiveYearPage posts={posts} year={year} {...blogTemplate} />
