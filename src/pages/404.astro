---
import { academic } from "@/config/academic";
import { blog } from "@/config/blog";
import { siteMode } from "@/config/runtime";
import NotFoundPage from "@/components/NotFoundPage.astro";

const siteTitle = siteMode === "blog" ? blog.title : siteMode === "academic" ? academic.title : "Lunecarnet";
const locale = siteMode === "academic" ? academic.language : blog.language;
---

<NotFoundPage siteTitle={siteTitle} locale={locale} />
