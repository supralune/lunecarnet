---
import AcademicHome from "@/components/AcademicHome.astro";
import { academic } from "@/config/academic";
import { templatePath } from "@/config/runtime";
import { identity } from "@/config/shared";
import BaseLayout from "@/layouts/BaseLayout.astro";

const siteOrigin = Astro.site ?? Astro.url.origin;
const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: identity.name,
  description: academic.bio,
  url: new URL(import.meta.env.BASE_URL.replace(/\/$/, "") + templatePath("academic"), siteOrigin).toString(),
  email: `mailto:${identity.email}`,
  affiliation: { "@type": "Organization", name: academic.role },
  sameAs: [identity.github, academic.scholar, academic.orcid].filter(Boolean)
};
---

<BaseLayout title={`${academic.title} · Academic`} description={academic.description} lang={academic.language} pageClass="academic-page" schema={schema}>
  <AcademicHome />
</BaseLayout>
