---
import { templatePath } from "../config/runtime";
import { categoryPath, getCategorySummaries, postPath, type Post } from "../lib/posts";
import type { BlogConfig } from "../types";
import { withBase } from "../lib/url";
import { formatMessage, resolveMessages, type MessageOverrides } from "../messages";

interface Props { posts: Post[]; blog: BlogConfig; messages?: MessageOverrides }
const { posts, blog, messages } = Astro.props;
const categories = getCategorySummaries(posts);
const visibleCategories = categories.slice(0, 4);
const hiddenCategories = categories.slice(4);
const ui = resolveMessages(blog.language, messages);
---

<aside class="sidebar blog-sidebar">
  <slot name="before" />
  <section class="sidebar-card">
    <p class="eyebrow">{ui.aboutThisPlace}</p>
    <p>{blog.about}</p>
    <a class="text-link" href={withBase(templatePath("blog", "/about/"))}>{ui.learnMore}</a>
  </section>
  {categories.length > 0 && <section class="widget">
    <h2>{ui.categories}</h2>
    <ul class="category-list category-list-primary">
      {visibleCategories.map((category) => (
        <li><a href={withBase(categoryPath(category.name))}><span>{category.name}</span><span>{category.posts.length}</span></a></li>
      ))}
    </ul>
    {hiddenCategories.length > 0 && <details class="category-more">
      <summary><span>{formatMessage(ui.remainingCategories, { count: hiddenCategories.length })}</span><span class="category-more-icon" aria-hidden="true">+</span></summary>
      <ul class="category-list category-list-hidden">
        {hiddenCategories.map((category) => (
          <li><a href={withBase(categoryPath(category.name))}><span>{category.name}</span><span>{category.posts.length}</span></a></li>
        ))}
      </ul>
    </details>}
    <a class="category-all-link" href={withBase(templatePath("blog", "/categories/"))}>{ui.viewAllCategories}</a>
  </section>}
  {posts.length > 0 && <section class="widget">
    <h2>{ui.recentNotes}</h2>
    <ol class="recent-list">
      {posts.slice(0, 3).map((post, index) => (
        <li><span>0{index + 1}</span><div><a href={withBase(postPath(post))}>{post.data.title}</a><small>{post.data.category}</small></div></li>
      ))}
    </ol>
  </section>}
  <section class="widget sidebar-contact">
    <h2>{ui.searchAndSubscribe}</h2>
    <p>{ui.searchAndSubscribeDescription}</p>
    <div class="sidebar-actions">
      <a class="text-link" href={withBase(templatePath("blog", "/search/"))}>{ui.searchNotes} →</a>
      <a class="text-link" href={withBase(templatePath("blog", "/rss.xml"))}>{ui.openRssFeed}</a>
    </div>
  </section>
  <slot />
</aside>
