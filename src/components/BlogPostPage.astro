---
import SiteFooter from "./SiteFooter.astro";
import BlogHeader from "./BlogHeader.astro";
import { templatePath } from "../config/runtime";
import BaseLayout from "../layouts/BaseLayout.astro";
import { categoryPath, formatDate, postModifiedDate, postPath, type Post } from "../lib/posts";
import type { BlogConfig, IdentityConfig } from "../types";
import { withBase } from "../lib/url";
import { render } from "astro:content";
import { formatMessage, resolveMessages, type MessageOverrides } from "../messages";
import "katex/dist/katex.min.css";

interface Props {
  post: Post;
  previous?: Post;
  next?: Post;
  blog: BlogConfig;
  identity: IdentityConfig;
  messages?: MessageOverrides;
}
const { post, previous, next, blog, identity, messages } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((heading) => heading.depth >= 1 && heading.depth <= 3);
const ui = resolveMessages(blog.language, messages);
const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishDate.toISOString(),
  dateModified: postModifiedDate(post).toISOString(),
  author: { "@type": "Person", name: identity.name },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString()
};
---

<BaseLayout title={post.data.title} description={post.data.description} lang={blog.language} pageClass="blog-page" type="article" publishedTime={post.data.publishDate} modifiedTime={post.data.updatedDate} schema={schema} feed={{ title: `${blog.title} RSS`, href: templatePath("blog", "/rss.xml") }} messages={messages}>
  <slot name="head" slot="head" />
  <div class="site-shell article-site">
    <BlogHeader blog={blog} messages={messages}>
      <slot name="header-actions" slot="actions" />
    </BlogHeader>
    <main class="article-main" id="main">
      <header class="article-header">
        <div class="article-breadcrumb"><a href={withBase(templatePath("blog"))}>{ui.home}</a><span>/</span><a href={withBase(categoryPath(post.data.category))}>{post.data.category}</a></div>
        <p class="eyebrow">{post.data.category}</p>
        <h1>{post.data.title}</h1>
        <p>{post.data.description}</p>
        <div class="article-meta">
          <time datetime={post.data.publishDate.toISOString()}>{formatMessage(ui.publishedOn, { date: formatDate(post.data.publishDate, blog.language) })}</time>
          {post.data.updatedDate && <><span>/</span><time datetime={post.data.updatedDate.toISOString()}>{formatMessage(ui.updatedOn, { date: formatDate(post.data.updatedDate, blog.language) })}</time></>}
          <span>/</span><span>{formatMessage(ui.minuteRead, { count: post.data.readingTime })}</span>
        </div>
      </header>
      <div class:list={["article-shell", { "has-toc": toc.length > 1 }]}>
        <article class="article-content"><Content /></article>
        {toc.length > 1 && (
          <aside class="toc" aria-label={ui.onThisPage}>
            <strong>{ui.onThisPage}</strong>
            <ol>{toc.map((heading) => <li class={`toc-depth-${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
          </aside>
        )}
      </div>
      <nav class="article-tags" aria-label={ui.noteTags}>{post.data.tags.map((tag) => <a href={`${withBase(templatePath("blog", "/search/"))}?q=${encodeURIComponent(tag)}`}>{tag}</a>)}</nav>
      <nav class:list={["post-navigation", { "is-single": !previous || !next }]} aria-label={ui.adjacentNotes}>
          {previous && (
            <a class="previous-note" href={withBase(postPath(previous))}>
              <small><span aria-hidden="true">←</span>{ui.previousNote}</small>
              <span class="post-navigation-title">{previous.data.title}</span>
            </a>
          )}
          {next && (
            <a class="next-note" href={withBase(postPath(next))}>
              <small>{ui.nextNote}<span aria-hidden="true">→</span></small>
              <span class="post-navigation-title">{next.data.title}</span>
            </a>
          )}
          {!previous && !next && (
            <a class="archive-note" href={withBase(templatePath("blog", "/archive/"))}>
              <small>{ui.archiveTitle}<span aria-hidden="true">→</span></small>
              <span class="post-navigation-title">{ui.browseArchive}</span>
            </a>
          )}
        </nav>
    </main>
    <SiteFooter variant="blog" identity={identity} locale={blog.language} messages={messages}>
      <slot name="footer-extra" slot="extra" />
    </SiteFooter>
  </div>
</BaseLayout>
