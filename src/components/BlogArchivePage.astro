---
import BlogPageLayout from "../layouts/BlogPageLayout.astro";
import EmptyState from "./EmptyState.astro";
import PageHeading from "./PageHeading.astro";
import { archiveYearPath, formatDate, getArchiveGroups, postPath, type Post } from "../lib/posts";
import { withBase } from "../lib/url";
import { formatMessage, resolveMessages } from "../messages";
import type { BlogTemplateConfig } from "../types";

interface Props extends BlogTemplateConfig { posts: Post[] }
const { posts, blog, identity, messages } = Astro.props;
const ui = resolveMessages(blog.language, messages);
const grouped = getArchiveGroups(posts);
---

<BlogPageLayout title={ui.archiveTitle} description={ui.archiveDescription} active="archive" posts={posts} blog={blog} identity={identity} messages={messages}>
  <slot name="head" slot="head" />
  <slot name="header-actions" slot="header-actions" />
  <PageHeading eyebrow={formatMessage(ui.archiveEyebrow, { count: posts.length })} title={ui.archiveTitle} intro={ui.archiveOverviewIntro} />

  <div class="archive-overview">
    {grouped.length > 0 ? grouped.map(([year, yearPosts]) => (
      <section class="archive-overview-year">
        <div class="archive-year-mark">
          <a href={withBase(archiveYearPath(year))}>{year}</a>
          <span>{formatMessage(yearPosts.length === 1 ? ui.noteCountOne : ui.noteCountMany, { count: yearPosts.length })}</span>
        </div>
        <div class="archive-year-preview">
          <div class="archive-year-range">
            <span>{formatDate(yearPosts.at(-1)!.data.publishDate, blog.language)} — {formatDate(yearPosts[0].data.publishDate, blog.language)}</span>
            <a href={withBase(archiveYearPath(year))}>{ui.viewYear}</a>
          </div>
          <ol>{yearPosts.slice(0, 3).map((post) => (
            <li>
              <time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate, blog.language)}</time>
              <a href={withBase(postPath(post))}>{post.data.title}</a>
            </li>
          ))}</ol>
          {yearPosts.length > 3 && <p>{formatMessage(ui.moreYearNotes, { count: yearPosts.length - 3 })}</p>}
        </div>
      </section>
    )) : <EmptyState title={ui.archiveEmptyTitle} description={ui.archiveEmptyDescription} />}
  </div>
  <slot />
  <slot name="sidebar" slot="sidebar" />
  <slot name="footer-extra" slot="footer-extra" />
</BlogPageLayout>
