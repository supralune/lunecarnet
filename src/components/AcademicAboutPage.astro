---
import AcademicPageLayout from "../layouts/AcademicPageLayout.astro";
import { resolveMessages } from "../messages";
import type { AcademicTemplateConfig } from "../types";

type Props = AcademicTemplateConfig;
const { academic, identity, publications, projects, education, honors, service, showEditingGuides = false, messages } = Astro.props;
const ui = resolveMessages(academic.language, messages);
---

<AcademicPageLayout title={ui.academicAboutTitle} description={ui.academicAboutDescription} active="about" academic={academic} identity={identity} projects={projects} publications={publications} showEditingGuides={showEditingGuides} messages={messages}>
  <slot name="head" slot="head" />
  <slot name="header-actions" slot="header-actions" />
  <header class="page-heading">
    <p class="eyebrow">{ui.academicAboutEyebrow}</p>
    <h1>{ui.academicAboutTitle}</h1>
    <p>{ui.academicAboutIntro}</p>
  </header>
  <section class="academic-detail-section"><h2>{ui.biography}</h2><p class="about-copy">{academic.longBio}</p></section>
  <section class="academic-detail-section">
    <h2>{ui.education}</h2>
    {education.map((item) => <div class="record-row"><div><h3>{item.title}</h3><p>{item.detail}</p></div>{item.period && <time>{item.period}</time>}</div>)}
  </section>
  <section class="academic-detail-section">
    <h2>{ui.honorsAwards}</h2>
    {honors.map((item) => <div class="record-row"><div><h3>{item.title}</h3><p>{item.detail}</p></div>{item.period && <time>{item.period}</time>}</div>)}
  </section>
  <section class="academic-detail-section"><h2>{ui.academicService}</h2><ul class="service-list">{service.map((item) => <li>{item}</li>)}</ul></section>
  <section class="academic-detail-section">
    <h2>{ui.contact}</h2>
    <dl class="contact-grid">
      <div><dt>{ui.email}</dt><dd><a href={`mailto:${identity.email}`}>{identity.email}</a></dd></div>
      {identity.github && <div><dt>{ui.github}</dt><dd><a href={identity.github} target="_blank" rel="noreferrer">{identity.github}</a></dd></div>}
      {identity.location && <div><dt>{ui.location}</dt><dd>{identity.location}</dd></div>}
    </dl>
  </section>
  <slot />
  <slot name="sidebar" slot="sidebar" />
  <slot name="footer-extra" slot="footer-extra" />
</AcademicPageLayout>
