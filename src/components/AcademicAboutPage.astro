---
import AcademicPageLayout from "../layouts/AcademicPageLayout.astro";
import { resolveMessages } from "../messages";
import type { AcademicTemplateConfig } from "../types";
import { textBlocks } from "../lib/text";
import PageHeading from "./PageHeading.astro";

type Props = AcademicTemplateConfig;
const { academic, identity, publications = [], projects = [], education = [], honors = [], service = [], messages } = Astro.props;
const ui = resolveMessages(academic.language, messages);
const biography = textBlocks(academic.longBio);
const researchInterests = academic.researchInterests ?? [];
---

<AcademicPageLayout title={ui.academicAboutTitle} description={ui.academicAboutDescription} active="about" academic={academic} identity={identity} projects={projects} publications={publications} messages={messages}>
  <slot name="head" slot="head" />
  <slot name="header-actions" slot="header-actions" />
  <PageHeading eyebrow={ui.academicAboutEyebrow} title={ui.academicAboutTitle} intro={ui.academicAboutIntro} />
  {biography.length > 0 && <section class="academic-detail-section"><h2>{ui.biography}</h2>{biography.map((paragraph) => <p class="about-copy">{paragraph}</p>)}</section>}
  {researchInterests.length > 0 && <section class="academic-detail-section">
    <h2>{ui.researchInterests}</h2>
    <div class="research-interest-list">
      {researchInterests.map((interest) => <article class="record-row"><div><h3>{interest.title}</h3><p>{interest.description}</p></div></article>)}
    </div>
  </section>}
  {education.length > 0 && <section class="academic-detail-section">
    <h2>{ui.education}</h2>
    {education.map((item) => <div class="record-row"><div><h3>{item.title}</h3><p>{item.detail}</p></div>{item.period && <time>{item.period}</time>}</div>)}
  </section>}
  {honors.length > 0 && <section class="academic-detail-section">
    <h2>{ui.honorsAwards}</h2>
    {honors.map((item) => <div class="record-row"><div><h3>{item.title}</h3><p>{item.detail}</p></div>{item.period && <time>{item.period}</time>}</div>)}
  </section>}
  {service.length > 0 && <section class="academic-detail-section"><h2>{ui.academicService}</h2><ul class="service-list">{service.map((item) => <li>{item}</li>)}</ul></section>}
  <section class="academic-detail-section">
    <h2>{ui.contact}</h2>
    <dl class="contact-grid">
      <div><dt>{ui.email}</dt><dd><a href={`mailto:${identity.email}`}>{identity.email}</a></dd></div>
      {identity.github && <div><dt>{ui.github}</dt><dd><a href={identity.github} target="_blank" rel="noreferrer">{identity.github}</a></dd></div>}
      {identity.location && <div><dt>{ui.location}</dt><dd>{identity.location}</dd></div>}
    </dl>
  </section>
  <slot />
  <slot name="sidebar" slot="sidebar" />
  <slot name="footer-extra" slot="footer-extra" />
</AcademicPageLayout>
