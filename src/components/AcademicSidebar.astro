---
import type { AcademicConfig, IdentityConfig, Project, Publication } from "../types";
import { formatMessage, resolveMessages, type MessageOverrides } from "../messages";

interface Props {
  academic: AcademicConfig;
  identity: IdentityConfig;
  projects: Project[];
  publications: Publication[];
  showEditingGuides?: boolean;
  messages?: MessageOverrides;
}
const { academic, identity, projects, publications, showEditingGuides = false, messages } = Astro.props;
const selectedPublicationCount = publications.filter((publication) => publication.selected).length;
const ui = resolveMessages(academic.language, messages);
---

<aside class="sidebar academic-sidebar">
  <section class="profile-card">
    {identity.avatar
      ? <img class="avatar avatar-image" src={identity.avatar} alt={`${identity.name} portrait`} />
      : <div class="avatar" aria-hidden="true">{identity.initials}</div>}
    <h2>{identity.name}</h2>
    <p>{academic.role}</p>
    <dl>
      <div><dt>{ui.email}</dt><dd><a href={`mailto:${identity.email}`}>{identity.email}</a></dd></div>
      {(identity.github || showEditingGuides) && <div><dt>{ui.github}</dt><dd>{identity.github ? <a href={identity.github} target="_blank" rel="noreferrer">{ui.profile}</a> : <span class="placeholder-link">{ui.addProfileUrl}</span>}</dd></div>}
      {(academic.orcid || showEditingGuides) && <div><dt>ORCID</dt><dd>{academic.orcid ? <a href={academic.orcid} target="_blank" rel="noreferrer">{ui.record}</a> : <span class="placeholder-link">{ui.addOrcidUrl}</span>}</dd></div>}
      {identity.location && <div><dt>{ui.based}</dt><dd>{identity.location}</dd></div>}
    </dl>
  </section>
  <slot name="after-profile" />
  <section class="widget">
    <h2>{ui.researchAreas}</h2>
    <div class="area-list">{academic.topics.map((topic) => <span>{topic}</span>)}</div>
  </section>
  <section class="widget">
    <h2>{ui.atAGlance}</h2>
    <ul class="plain-list">
      <li>{formatMessage(ui.selectedPublicationCount, { count: selectedPublicationCount })}</li>
      <li>{formatMessage(ui.activeProjectCount, { count: projects.length })}</li>
      {academic.availability && <li>{academic.availability}</li>}
    </ul>
  </section>
  <slot />
</aside>
