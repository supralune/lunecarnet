---
import type { AcademicConfig, IdentityConfig, Project, Publication } from "../types";
import { formatMessage, resolveMessages, type MessageOverrides } from "../messages";

interface Props {
  academic: AcademicConfig;
  identity: IdentityConfig;
  projects: Project[];
  publications: Publication[];
  messages?: MessageOverrides;
}
const { academic, identity, projects, publications, messages } = Astro.props;
const selectedPublicationCount = publications.filter((publication) => publication.selected).length;
const topics = academic.topics ?? [];
const showSummary = selectedPublicationCount > 0 || projects.length > 0 || Boolean(academic.availability);
const ui = resolveMessages(academic.language, messages);
---

<aside class="sidebar academic-sidebar">
  <section class="profile-card">
    {identity.avatar
      ? <img class="avatar avatar-image" src={identity.avatar} alt={formatMessage(ui.portraitAlt, { name: identity.name })} />
      : <div class="avatar" aria-hidden="true">{identity.initials}</div>}
    <h2>{identity.name}</h2>
    <p>{academic.role}</p>
    <dl>
      <div><dt>{ui.email}</dt><dd><a href={`mailto:${identity.email}`}>{identity.email}</a></dd></div>
      {identity.github && <div><dt>{ui.github}</dt><dd><a href={identity.github} target="_blank" rel="noreferrer">{ui.profile}</a></dd></div>}
      {academic.orcid && <div><dt>ORCID</dt><dd><a href={academic.orcid} target="_blank" rel="noreferrer">{ui.record}</a></dd></div>}
      {identity.location && <div><dt>{ui.based}</dt><dd>{identity.location}</dd></div>}
    </dl>
  </section>
  <slot name="after-profile" />
  {topics.length > 0 && <section class="widget">
    <h2>{ui.researchAreas}</h2>
    <div class="area-list">{topics.map((topic) => <span>{topic}</span>)}</div>
  </section>}
  {showSummary && <section class="widget">
    <h2>{ui.atAGlance}</h2>
    <ul class="plain-list">
      {selectedPublicationCount > 0 && <li>{formatMessage(ui.selectedPublicationCount, { count: selectedPublicationCount })}</li>}
      {projects.length > 0 && <li>{formatMessage(ui.activeProjectCount, { count: projects.length })}</li>}
      {academic.availability && <li>{academic.availability}</li>}
    </ul>
  </section>}
  <slot />
</aside>
