---
import AcademicPageLayout from "../layouts/AcademicPageLayout.astro";
import { resolveMessages } from "../messages";
import type { AcademicTemplateConfig } from "../types";
import PageHeading from "./PageHeading.astro";
import ProjectItem from "./ProjectItem.astro";

type Props = AcademicTemplateConfig;
const { academic, identity, publications = [], projects = [], messages } = Astro.props;
const ui = resolveMessages(academic.language, messages);
---

<AcademicPageLayout title={ui.projectsTitle} description={ui.projectsDescription} active="projects" academic={academic} identity={identity} projects={projects} publications={publications} messages={messages}>
  <slot name="head" slot="head" />
  <slot name="header-actions" slot="header-actions" />
  <PageHeading eyebrow={ui.projectsEyebrow} title={ui.projectsTitle} intro={ui.projectsIntro} />
  <div class="project-grid">
    {projects.map((project, index) => <ProjectItem project={project} variant="card" index={index} locale={academic.language} messages={messages} />)}
  </div>
  <slot />
  <slot name="sidebar" slot="sidebar" />
  <slot name="footer-extra" slot="footer-extra" />
</AcademicPageLayout>
