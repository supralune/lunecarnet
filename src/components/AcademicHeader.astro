---
import SiteHeader from "./SiteHeader.astro";
import type { AcademicConfig } from "../types";

interface Props { academic: AcademicConfig; active?: string }
const { academic, active = "home" } = Astro.props;
---

<SiteHeader variant="academic" title={academic.title} description={academic.description} navigation={academic.nav} active={active}>
  <slot name="actions" slot="actions" />
</SiteHeader>
