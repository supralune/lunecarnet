---
import { dateParts, formatDate, postPath, type Post } from "@/lib/posts";
import { withBase } from "@/lib/url";

interface Props { post: Post; featured?: boolean }
const { post, featured = false } = Astro.props;
const date = dateParts(post.data.publishDate);
---

<article class:list={["post-item", { featured }]}>
  <time class="date-block" datetime={post.data.publishDate.toISOString()}>
    <span class="day">{date.day}</span>
    <span class="month">{date.month}</span>
  </time>
  <div class="post-body">
    <p class="post-kicker">{post.data.category}{featured && <span>FEATURED</span>}</p>
    <h2><a href={withBase(postPath(post))}>{post.data.title}</a></h2>
    <p>{post.data.description}</p>
    <div class="post-meta">
      <span>{formatDate(post.data.publishDate)}</span>
      <span class="meta-divider">/</span>
      <span>{post.data.readingTime} min read</span>
      <a class="read-more" href={withBase(postPath(post))}>Read article <span aria-hidden="true">→</span></a>
    </div>
  </div>
</article>
