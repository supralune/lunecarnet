---
import { categoryPath, dateParts, formatDate, postPath, type Post } from "../lib/posts";
import { withBase } from "../lib/url";
import { formatMessage, resolveMessages, type MessageOverrides } from "../messages";

interface Props { post: Post; featured?: boolean; locale?: string; messages?: MessageOverrides }
const { post, featured = false, locale = "en", messages } = Astro.props;
const date = dateParts(post.data.publishDate, locale);
const ui = resolveMessages(locale, messages);
---

<article class:list={["post-item", { featured }]}>
  <time class="date-block" datetime={post.data.publishDate.toISOString()}>
    <span class="day">{date.day}</span>
    <span class="month">{date.month}</span>
  </time>
  <div class="post-body">
    <p class="post-kicker"><a href={withBase(categoryPath(post.data.category))}>{post.data.category}</a>{featured && <span>{ui.featured}</span>}</p>
    <h2><a href={withBase(postPath(post))}>{post.data.title}</a></h2>
    <p>{post.data.description}</p>
    <div class="post-meta">
      <span>{formatDate(post.data.publishDate, locale)}</span>
      <span class="meta-divider">/</span>
      <span>{formatMessage(ui.minuteRead, { count: post.data.readingTime })}</span>
      <a class="read-more" href={withBase(postPath(post))}>{ui.readArticle} <span aria-hidden="true">→</span></a>
    </div>
  </div>
</article>
