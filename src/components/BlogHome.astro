---
import PostItem from "./PostItem.astro";
import EmptyState from "./EmptyState.astro";
import BlogShell from "./BlogShell.astro";
import TemplateGuide from "./TemplateGuide.astro";
import { templatePath } from "../config/runtime";
import type { Post } from "../lib/posts";
import type { BlogConfig, IdentityConfig } from "../types";
import { withBase } from "../lib/url";
import { formatMessage, resolveMessages, type MessageOverrides } from "../messages";

interface Props {
  posts: Post[];
  blog: BlogConfig;
  identity: IdentityConfig;
  showEditingGuides?: boolean;
  messages?: MessageOverrides;
  blogHomePostLimit?: number;
}
const { posts, blog, identity, showEditingGuides = false, messages, blogHomePostLimit = 8 } = Astro.props;
const ui = resolveMessages(blog.language, messages);
const homePosts = posts.slice(0, Math.max(0, blogHomePostLimit));
---

<BlogShell posts={posts} blog={blog} identity={identity} showEditingGuides={showEditingGuides} messages={messages}>
  <slot name="header-actions" slot="header-actions" />
      <section class="blog-hero">
        <p class="eyebrow">{formatMessage(ui.blogHeroEyebrow, { year: blog.foundedYear })}</p>
        <h1>{blog.hero}</h1>
        <p>{blog.intro}</p>
      </section>

      <slot name="after-hero" />

      <TemplateGuide compact enabled={showEditingGuides}>
        <p>{ui.blogEditingGuide}</p>
      </TemplateGuide>

      <section id="notes" class="content-section">
        <div class="section-heading">
          <h2>{ui.latestNotes}</h2>
          <a class="section-more" href={withBase(templatePath("blog", "/archive/"))}>{ui.viewArchive}</a>
        </div>
        <div class="post-list">
          {homePosts.length > 0
            ? homePosts.map((post, index) => <PostItem post={post} featured={index === 0 && post.data.featured} locale={blog.language} messages={messages} />)
            : <EmptyState title={ui.noNotesTitle} description={ui.noNotesDescription} />}
        </div>
      </section>
  <slot />
  <slot name="sidebar" slot="sidebar" />
  <slot name="footer-extra" slot="footer-extra" />
</BlogShell>
