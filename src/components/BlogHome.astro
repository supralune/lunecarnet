---
import PostItem from "./PostItem.astro";
import BlogSidebar from "./BlogSidebar.astro";
import EmptyState from "./EmptyState.astro";
import SiteFooter from "./SiteFooter.astro";
import BlogHeader from "./BlogHeader.astro";
import TemplateGuide from "./TemplateGuide.astro";
import { templatePath } from "../config/runtime";
import type { Post } from "../lib/posts";
import type { BlogConfig, IdentityConfig } from "../types";
import { withBase } from "../lib/url";

interface Props {
  posts: Post[];
  blog: BlogConfig;
  identity: IdentityConfig;
  showEditingGuides?: boolean;
}
const { posts, blog, identity, showEditingGuides = false } = Astro.props;
---

<div class="site-shell blog-shell">
  <BlogHeader blog={blog} active="home">
    <slot name="header-actions" slot="actions" />
  </BlogHeader>
  <div class="page-layout">
    <main class="main-content" id="main">
      <section class="blog-hero">
        <p class="eyebrow">PERSONAL NOTES · SINCE {blog.foundedYear}</p>
        <h1>{blog.hero}</h1>
        <p>{blog.intro}</p>
      </section>

      <slot name="after-hero" />

      <TemplateGuide compact enabled={showEditingGuides}>
        <p>Replace the blog fields in <code>src/config/blog.ts</code> and identity fields in <code>src/config/shared.ts</code>, then set <code>showEditingGuides</code> to <code>false</code>.</p>
      </TemplateGuide>

      <section id="notes" class="content-section">
        <div class="section-heading">
          <h2>Latest Notes</h2>
          <a class="section-more" href={withBase(templatePath("blog", "/archive/"))}>View archive →</a>
        </div>
        <div class="post-list">
          {posts.length > 0
            ? posts.map((post, index) => <PostItem post={post} featured={index === 0 && post.data.featured} />)
            : <EmptyState title="No notes published yet" description="Add your first Markdown file to src/content/posts/ and it will appear here automatically." />}
        </div>
      </section>
      <slot />
    </main>

    <BlogSidebar posts={posts} blog={blog}>
      <slot name="sidebar" />
    </BlogSidebar>
  </div>
  <SiteFooter variant="blog" identity={identity} showEditingGuides={showEditingGuides}>
    <slot name="footer-extra" slot="extra" />
  </SiteFooter>
</div>
