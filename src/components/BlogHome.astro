---
import PostItem from "./PostItem.astro";
import BlogSidebar from "./BlogSidebar.astro";
import EmptyState from "./EmptyState.astro";
import SiteFooter from "./SiteFooter.astro";
import BlogHeader from "./BlogHeader.astro";
import TemplateGuide from "./TemplateGuide.astro";
import { templatePath } from "../config/runtime";
import type { Post } from "../lib/posts";
import type { BlogConfig, IdentityConfig } from "../types";
import { withBase } from "../lib/url";
import { formatMessage, resolveMessages, type MessageOverrides } from "../messages";

interface Props {
  posts: Post[];
  blog: BlogConfig;
  identity: IdentityConfig;
  showEditingGuides?: boolean;
  messages?: MessageOverrides;
}
const { posts, blog, identity, showEditingGuides = false, messages } = Astro.props;
const ui = resolveMessages(blog.language, messages);
---

<div class="site-shell blog-shell">
  <BlogHeader blog={blog} active="home" messages={messages}>
    <slot name="header-actions" slot="actions" />
  </BlogHeader>
  <div class="page-layout">
    <main class="main-content" id="main">
      <section class="blog-hero">
        <p class="eyebrow">{formatMessage(ui.blogHeroEyebrow, { year: blog.foundedYear })}</p>
        <h1>{blog.hero}</h1>
        <p>{blog.intro}</p>
      </section>

      <slot name="after-hero" />

      <TemplateGuide compact enabled={showEditingGuides}>
        <p>Replace the blog fields in <code>src/config/blog.ts</code> and identity fields in <code>src/config/shared.ts</code>, then set <code>showEditingGuides</code> to <code>false</code>.</p>
      </TemplateGuide>

      <section id="notes" class="content-section">
        <div class="section-heading">
          <h2>{ui.latestNotes}</h2>
          <a class="section-more" href={withBase(templatePath("blog", "/archive/"))}>{ui.viewArchive}</a>
        </div>
        <div class="post-list">
          {posts.length > 0
            ? posts.map((post, index) => <PostItem post={post} featured={index === 0 && post.data.featured} locale={blog.language} messages={messages} />)
            : <EmptyState title={ui.noNotesTitle} description={ui.noNotesDescription} />}
        </div>
      </section>
      <slot />
    </main>

    <BlogSidebar posts={posts} blog={blog} messages={messages}>
      <slot name="sidebar" />
    </BlogSidebar>
  </div>
  <SiteFooter variant="blog" identity={identity} showEditingGuides={showEditingGuides} locale={blog.language} messages={messages}>
    <slot name="footer-extra" slot="extra" />
  </SiteFooter>
</div>
