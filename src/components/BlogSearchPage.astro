---
import BlogPageLayout from "../layouts/BlogPageLayout.astro";
import { postPath, type Post } from "../lib/posts";
import { templatePath } from "../config/runtime";
import { withBase } from "../lib/url";
import { formatMessage, resolveMessages } from "../messages";
import type { BlogTemplateConfig } from "../types";
import PageHeading from "./PageHeading.astro";

interface Props extends BlogTemplateConfig { posts: Post[] }
const { posts, blog, identity, showEditingGuides = false, messages } = Astro.props;
const ui = resolveMessages(blog.language, messages);
const searchIndex = posts.map((post) => ({
  title: post.data.title,
  description: post.data.description,
  category: post.data.category,
  tags: post.data.tags,
  date: post.data.publishDate.toISOString(),
  path: withBase(postPath(post)),
  body: post.body ?? ""
}));
const serializedIndex = JSON.stringify(searchIndex).replace(/</g, "\\u003c");
const clientUi = JSON.stringify({
  locale: blog.language,
  prompt: ui.searchPrompt,
  foundOne: ui.searchFoundOne,
  foundMany: ui.searchFoundMany,
  empty: ui.searchEmpty
}).replace(/</g, "\\u003c");
---

<BlogPageLayout title={ui.searchTitle} description={ui.searchDescription} active="search" posts={posts} blog={blog} identity={identity} showEditingGuides={showEditingGuides} messages={messages}>
  <slot name="head" slot="head" />
  <slot name="header-actions" slot="header-actions" />
  <PageHeading eyebrow={formatMessage(ui.searchEyebrow, { count: posts.length })} title={ui.searchHeading} intro={ui.searchIntro} />

  <div class="search-box">
    <label class="sr-only" for="note-search">{ui.searchNotes}</label>
    <span class="search-symbol" aria-hidden="true">⌕</span>
    <input id="note-search" type="search" inputmode="search" autocomplete="off" placeholder={ui.searchPlaceholder} />
    <button id="search-clear" type="button" aria-label={ui.clearSearch} hidden>{ui.clear}</button>
  </div>
  <p class="search-status" id="search-status" aria-live="polite">{ui.searchPrompt}</p>
  <div class="search-results" id="search-results"></div>
  <noscript><p class="search-empty">{ui.searchRequiresJs} <a href={withBase(templatePath("blog", "/archive/"))}>{ui.archiveTitle}</a></p></noscript>
  <script is:inline id="search-index" type="application/json" set:html={serializedIndex}></script>
  <script is:inline id="search-messages" type="application/json" set:html={clientUi}></script>
  <script is:inline>
    const indexElement = document.querySelector("#search-index");
    const messagesElement = document.querySelector("#search-messages");
    const input = document.querySelector("#note-search");
    const clearButton = document.querySelector("#search-clear");
    const status = document.querySelector("#search-status");
    const results = document.querySelector("#search-results");
    const index = JSON.parse(indexElement?.textContent || "[]");
    const ui = JSON.parse(messagesElement?.textContent || "{}");
    const message = (template, values = {}) => template.replace(/\{(\w+)\}/g, (_, key) => String(values[key] ?? `{${key}}`));
    const normalize = (value) => value.toLowerCase().normalize("NFKD");
    const formatDate = (value) => new Intl.DateTimeFormat(ui.locale, { year: "numeric", month: "short", day: "numeric" }).format(new Date(value));

    const renderResults = (query) => {
      const terms = normalize(query).trim().split(/\s+/).filter(Boolean);
      results.replaceChildren();
      clearButton.hidden = terms.length === 0;
      if (!terms.length) { status.textContent = ui.prompt; return; }

      const matches = index.filter((item) => {
        const haystack = normalize([item.title, item.description, item.category, ...item.tags, item.body].join(" "));
        return terms.every((term) => haystack.includes(term));
      });
      status.textContent = message(matches.length === 1 ? ui.foundOne : ui.foundMany, { count: matches.length, query: query.trim() });

      if (!matches.length) {
        const empty = document.createElement("p");
        empty.className = "search-empty";
        empty.textContent = ui.empty;
        results.append(empty);
        return;
      }

      matches.forEach((item) => {
        const article = document.createElement("article");
        article.className = "search-result";
        const heading = document.createElement("h2");
        const link = document.createElement("a");
        link.href = item.path;
        link.textContent = item.title;
        heading.append(link);
        const excerpt = document.createElement("p");
        excerpt.textContent = item.description;
        const meta = document.createElement("p");
        meta.className = "search-result-meta";
        meta.textContent = `${formatDate(item.date)} · ${item.category}`;
        article.append(heading, excerpt, meta);
        results.append(article);
      });
    };

    const initialQuery = new URLSearchParams(location.search).get("q") || "";
    input.value = initialQuery;
    renderResults(initialQuery);
    input.addEventListener("input", () => {
      renderResults(input.value);
      const url = new URL(location.href);
      input.value.trim() ? url.searchParams.set("q", input.value.trim()) : url.searchParams.delete("q");
      history.replaceState({}, "", url);
    });
    clearButton.addEventListener("click", () => {
      input.value = "";
      renderResults("");
      history.replaceState({}, "", location.pathname);
      input.focus();
    });
  </script>
  <slot />
  <slot name="sidebar" slot="sidebar" />
  <slot name="footer-extra" slot="footer-extra" />
</BlogPageLayout>
