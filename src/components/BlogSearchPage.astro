---
import BlogPageLayout from "../layouts/BlogPageLayout.astro";
import { postPath, type Post } from "../lib/posts";
import { markdownToSearchText } from "../lib/search-text";
import { templatePath } from "../config/runtime";
import { withBase } from "../lib/url";
import { formatMessage, resolveMessages } from "../messages";
import type { BlogTemplateConfig } from "../types";
import PageHeading from "./PageHeading.astro";

interface Props extends BlogTemplateConfig { posts: Post[] }
const { posts, blog, identity, messages } = Astro.props;
const ui = resolveMessages(blog.language, messages);
const searchIndex = posts.map((post) => ({
  title: post.data.title,
  description: post.data.description,
  category: post.data.category,
  tags: post.data.tags,
  date: post.data.publishDate.toISOString(),
  path: withBase(postPath(post)),
  body: markdownToSearchText(post.body ?? "")
}));
const serializedIndex = JSON.stringify(searchIndex).replace(/</g, "\u003c");
const clientUi = JSON.stringify({
  locale: blog.language,
  prompt: ui.searchPrompt,
  foundOne: ui.searchFoundOne,
  foundMany: ui.searchFoundMany,
  empty: ui.searchEmpty,
  bodyMatch: ui.searchBodyMatch,
  articleMatch: ui.searchArticleMatch
}).replace(/</g, "\u003c");
---

<BlogPageLayout title={ui.searchTitle} description={ui.searchDescription} active="search" posts={posts} blog={blog} identity={identity} messages={messages}>
  <slot name="head" slot="head" />
  <slot name="header-actions" slot="header-actions" />
  <PageHeading eyebrow={formatMessage(ui.searchEyebrow, { count: posts.length })} title={ui.searchHeading} intro={ui.searchIntro} />

  <div class="search-box">
    <label class="sr-only" for="note-search">{ui.searchNotes}</label>
    <span class="search-symbol" aria-hidden="true">⌕</span>
    <input id="note-search" type="search" inputmode="search" autocomplete="off" enterkeyhint="search" placeholder={ui.searchPlaceholder} aria-describedby="search-status" aria-controls="search-results" aria-keyshortcuts="/" />
    <button id="search-clear" type="button" aria-label={ui.clearSearch} hidden>{ui.clear}</button>
  </div>
  <p class="search-status" id="search-status" role="status" aria-live="polite">{ui.searchPrompt}</p>
  <div class="search-results" id="search-results" role="list"></div>
  <noscript><p class="search-empty">{ui.searchRequiresJs} <a href={withBase(templatePath("blog", "/archive/"))}>{ui.archiveTitle}</a></p></noscript>
  <script is:inline id="search-index" type="application/json" set:html={serializedIndex}></script>
  <script is:inline id="search-messages" type="application/json" set:html={clientUi}></script>
  <script>
    import { createSearchExcerpt, searchPosts, tokenizeSearchQuery, type SearchPost } from "../lib/search-core";

    const requireElement = <T extends Element>(selector: string) => {
      const element = document.querySelector<T>(selector);
      if (!element) throw new Error(`Missing search element: ${selector}`);
      return element;
    };
    const input = requireElement<HTMLInputElement>("#note-search");
    const clearButton = requireElement<HTMLButtonElement>("#search-clear");
    const status = requireElement<HTMLElement>("#search-status");
    const results = requireElement<HTMLElement>("#search-results");
    const index = JSON.parse(requireElement<HTMLScriptElement>("#search-index").textContent || "[]") as SearchPost[];
    const ui = JSON.parse(requireElement<HTMLScriptElement>("#search-messages").textContent || "{}");
    const message = (template: string, values: Record<string, string | number> = {}) =>
      template.replace(/\{(\w+)\}/g, (match, key: string) => String(values[key] ?? match));
    const formatDate = (value: string) =>
      new Intl.DateTimeFormat(ui.locale, { year: "numeric", month: "short", day: "numeric" }).format(new Date(value));

    const appendHighlightedText = (element: HTMLElement, value: string, terms: string[]) => {
      const escapedTerms = [...terms].sort((a, b) => b.length - a.length)
        .map((term) => term.replace(/[-/\\^\$*+?.()|[\]{}]/g, "\\$&"));
      if (!escapedTerms.length) { element.textContent = value; return; }
      const matcher = new RegExp(`(${escapedTerms.join("|")})`, "giu");
      let previousIndex = 0;
      for (const match of value.matchAll(matcher)) {
        const matchIndex = match.index ?? 0;
        element.append(document.createTextNode(value.slice(previousIndex, matchIndex)));
        const mark = document.createElement("mark");
        mark.textContent = match[0];
        element.append(mark);
        previousIndex = matchIndex + match[0].length;
      }
      element.append(document.createTextNode(value.slice(previousIndex)));
    };

    const createResult = (post: SearchPost, terms: string[]) => {
      const article = document.createElement("article");
      article.className = "search-result";
      article.setAttribute("role", "listitem");
      const heading = document.createElement("h2");
      const link = document.createElement("a");
      link.href = post.path;
      appendHighlightedText(link, post.title, terms);
      heading.append(link);
      const excerptData = createSearchExcerpt(post, terms);
      const excerpt = document.createElement("p");
      excerpt.className = "search-excerpt";
      appendHighlightedText(excerpt, excerptData.text, terms);
      const meta = document.createElement("p");
      meta.className = "search-result-meta";
      appendHighlightedText(meta, [excerptData.fromBody ? ui.bodyMatch : ui.articleMatch, formatDate(post.date), post.category, ...post.tags.map((tag) => `#${tag}`)].join(" · "), terms);
      article.append(heading, excerpt, meta);
      return article;
    };

    const updateUrl = (query: string) => {
      const url = new URL(location.href);
      query.trim() ? url.searchParams.set("q", query.trim()) : url.searchParams.delete("q");
      history.replaceState(null, "", `${url.pathname}${url.search}${url.hash}`);
    };
    const renderResults = (query: string, syncUrl = true) => {
      const terms = tokenizeSearchQuery(query);
      clearButton.hidden = !query;
      if (syncUrl) updateUrl(query);
      if (!terms.length) { results.replaceChildren(); status.textContent = ui.prompt; return; }
      const matches = searchPosts(index, query);
      status.textContent = message(matches.length === 1 ? ui.foundOne : ui.foundMany, { count: matches.length, query: query.trim() });
      if (!matches.length) {
        const empty = document.createElement("p");
        empty.className = "search-empty";
        empty.textContent = ui.empty;
        results.replaceChildren(empty);
        return;
      }
      results.replaceChildren(...matches.map((post) => createResult(post, terms)));
    };

    let composing = false;
    input.addEventListener("compositionstart", () => { composing = true; });
    input.addEventListener("compositionend", () => { composing = false; renderResults(input.value); });
    input.addEventListener("input", () => { if (!composing) renderResults(input.value); });
    input.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && input.value) { event.preventDefault(); input.value = ""; renderResults(""); }
    });
    clearButton.addEventListener("click", () => { input.value = ""; renderResults(""); input.focus(); });
    document.addEventListener("keydown", (event) => {
      const target = event.target as HTMLElement | null;
      if (event.key === "/" && !target?.matches("input, textarea, select, [contenteditable='true']") && !event.metaKey && !event.ctrlKey && !event.altKey) {
        event.preventDefault();
        input.focus();
      }
    });
    const initialQuery = new URLSearchParams(location.search).get("q") || "";
    input.value = initialQuery;
    renderResults(initialQuery, false);
  </script>
  <slot />
  <slot name="sidebar" slot="sidebar" />
  <slot name="footer-extra" slot="footer-extra" />
</BlogPageLayout>
