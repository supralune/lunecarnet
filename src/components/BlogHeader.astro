---
import SiteHeader from "./SiteHeader.astro";
import type { BlogConfig } from "../types";
import type { MessageOverrides } from "../messages";

interface Props { blog: BlogConfig; active?: string; messages?: MessageOverrides }
const { blog, active = "home", messages } = Astro.props;
---

<SiteHeader variant="blog" title={blog.title} description={blog.description} navigation={blog.nav} active={active} locale={blog.language} messages={messages}>
  <slot name="actions" slot="actions" />
</SiteHeader>
