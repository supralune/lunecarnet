---
import SiteHeader from "./SiteHeader.astro";
import type { BlogConfig } from "../types";

interface Props { blog: BlogConfig; active?: string }
const { blog, active = "home" } = Astro.props;
---

<SiteHeader variant="blog" title={blog.title} description={blog.description} navigation={blog.nav} active={active}>
  <slot name="actions" slot="actions" />
</SiteHeader>
