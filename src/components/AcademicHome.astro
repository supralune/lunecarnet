---
import AcademicShell from "./AcademicShell.astro";
import PublicationRow from "./PublicationRow.astro";
import ProjectItem from "./ProjectItem.astro";
import { templatePath } from "../config/runtime";
import type { AcademicConfig, AcademicHomeLimits, AcademicHomeSections, IdentityConfig, NewsItem, Project, Publication } from "../types";
import { withBase } from "../lib/url";
import { resolveMessages, type MessageOverrides } from "../messages";
import { textBlocks } from "../lib/text";

interface Props {
  academic: AcademicConfig;
  identity: IdentityConfig;
  publications?: Publication[];
  projects?: Project[];
  news?: NewsItem[];
  messages?: MessageOverrides;
  homeSections?: AcademicHomeSections;
  homeLimits?: AcademicHomeLimits;
}
const { academic, identity, publications = [], projects = [], news = [], messages, homeSections, homeLimits } = Astro.props;
const selectedPublications = publications.filter((publication) => publication.selected).slice(0, Math.max(0, homeLimits?.publications ?? 5));
const selectedProjects = projects.filter((project) => project.selected !== false).slice(0, Math.max(0, homeLimits?.projects ?? 4));
const latestNews = news.slice(0, Math.max(0, homeLimits?.news ?? 6));
const topics = academic.topics ?? [];
const longBio = textBlocks(academic.longBio);
const showPublications = homeSections?.publications !== false && selectedPublications.length > 0;
const showProjects = homeSections?.projects !== false && selectedProjects.length > 0;
const showAbout = homeSections?.about !== false && longBio.length > 0;
const showNews = homeSections?.news !== false && latestNews.length > 0;
const ui = resolveMessages(academic.language, messages);
---

<AcademicShell academic={academic} identity={identity} projects={projects} publications={publications} messages={messages}>
  <slot name="header-actions" slot="header-actions" />
      <section class="academic-hero">
        <p class="eyebrow">{ui.researchProfile}</p>
        <h1>{academic.headline}</h1>
        <p>{academic.bio}</p>
        {topics.length > 0 && <div class="topic-list">{topics.map((topic) => <span>{topic}</span>)}</div>}
        <div class="hero-actions">
          {academic.scholar && <a class="button primary" href={academic.scholar} target="_blank" rel="noreferrer">{ui.googleScholar}</a>}
          <a class="button" href={`mailto:${identity.email}`}>{ui.emailMe}</a>
          {academic.cvUrl && <a class="button" href={academic.cvUrl}>{ui.downloadCv}</a>}
        </div>
      </section>

      <slot name="after-hero" />

      {showPublications && <section class="content-section" id="publications">
        <div class="section-heading ruled"><h2>{ui.selectedPublications}</h2><a class="section-more" href={withBase(templatePath("academic", "/publications/"))}>{ui.viewAll}</a></div>
        <p class="publication-legend">{ui.publicationLegend}</p>
        <div class="publication-list">
          {selectedPublications.map((publication, index) => <PublicationRow publication={publication} highlight={index === 0} locale={academic.language} messages={messages} />)}
        </div>
      </section>}

      {showProjects && <section class="content-section" id="projects">
        <div class="section-heading ruled"><h2>{ui.selectedProjects}</h2><a class="section-more" href={withBase(templatePath("academic", "/projects/"))}>{ui.viewAll}</a></div>
        {selectedProjects.map((project) => <ProjectItem project={project} locale={academic.language} messages={messages} />)}
      </section>}

      {showAbout && <section class="content-section" id="about">
        <div class="section-heading ruled"><h2>{ui.about}</h2><a class="section-more" href={withBase(templatePath("academic", "/about/"))}>{ui.fullProfile}</a></div>
        {longBio.map((paragraph) => <p class="about-copy">{paragraph}</p>)}
      </section>}

      {showNews && <section class="content-section" id="news">
        <div class="section-heading ruled"><h2>{ui.latestNews}</h2><span>{ui.updates}</span></div>
        <div class="news-list">{latestNews.map((item) => <div><time>{item.date}</time><p>{item.text}</p></div>)}</div>
      </section>}
  <slot />
  <slot name="sidebar" slot="sidebar" />
  <slot name="footer-extra" slot="footer-extra" />
</AcademicShell>
