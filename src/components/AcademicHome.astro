---
import AcademicSidebar from "@/components/AcademicSidebar.astro";
import PublicationRow from "@/components/PublicationRow.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import AcademicHeader from "@/components/AcademicHeader.astro";
import TemplateGuide from "@/components/TemplateGuide.astro";
import { academic, news, projects, publications } from "@/config/academic";
import { templatePath } from "@/config/runtime";
import { identity, showEditingGuides } from "@/config/shared";
import { withBase } from "@/lib/url";

const selectedPublications = publications.filter((publication) => publication.selected);
---

<div class="site-shell academic-shell">
  <AcademicHeader active="home" />
  <div class="page-layout">
    <main class="main-content" id="main">
      <section class="academic-hero">
        <p class="eyebrow">RESEARCH PROFILE</p>
        <h1>{academic.headline}</h1>
        <p>{academic.bio}</p>
        <div class="topic-list">{academic.topics.map((topic) => <span>{topic}</span>)}</div>
        <div class="hero-actions">
          {academic.scholar ? <a class="button primary" href={academic.scholar} target="_blank" rel="noreferrer">Google Scholar</a> : showEditingGuides && <span class="button primary disabled">Add Scholar URL</span>}
          <a class="button" href={`mailto:${identity.email}`}>Email me</a>
          {academic.cvUrl ? <a class="button" href={academic.cvUrl}>Download CV</a> : showEditingGuides && <span class="button disabled">Add CV URL</span>}
        </div>
      </section>

      <TemplateGuide compact>
        <p>Replace the placeholders in <code>src/config/academic.ts</code> with your own profile, publications, projects, and updates.</p>
      </TemplateGuide>

      <section class="content-section" id="publications">
        <div class="section-heading ruled"><h2>Selected Publications</h2><a class="section-more" href={withBase(templatePath("academic", "/publications/"))}>View all →</a></div>
        <p class="publication-legend"><span class="self-author">Your Name</span> indicates the profile owner; <sup>*</sup> indicates the corresponding author.</p>
        <div class="publication-list">
          {selectedPublications.map((publication, index) => <PublicationRow publication={publication} highlight={index === 0} />)}
        </div>
      </section>

      <section class="content-section" id="projects">
        <div class="section-heading ruled"><h2>Selected Projects</h2><a class="section-more" href={withBase(templatePath("academic", "/projects/"))}>View all →</a></div>
        {projects.map((project) => (
          <article class="project-row">
            <div class="project-title"><h3>{project.link ? <a href={project.link} target="_blank" rel="noreferrer">{project.title}</a> : project.title}</h3><span>{project.period}</span></div>
            <p>{project.description}</p>
            <div class="project-tags">{project.tags.map((tag) => <span>{tag}</span>)}</div>
          </article>
        ))}
      </section>

      <section class="content-section" id="about">
        <div class="section-heading ruled"><h2>About</h2><a class="section-more" href={withBase(templatePath("academic", "/about/"))}>Full profile →</a></div>
        <p class="about-copy">{academic.longBio}</p>
      </section>

      <section class="content-section">
        <div class="section-heading ruled"><h2>Latest News</h2><span>UPDATES</span></div>
        <div class="news-list">{news.map((item) => <div><time>{item.date}</time><p>{item.text}</p></div>)}</div>
      </section>
    </main>

    <AcademicSidebar />
  </div>
  <SiteFooter variant="academic" />
</div>
