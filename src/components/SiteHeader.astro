---
import { isCombinedSite, templatePath } from "@/config/runtime";
import type { SiteVariant } from "@/config/shared";
import { withBase } from "@/lib/url";

interface Props {
  variant: SiteVariant;
  title: string;
  description: string;
  navigation: Array<{ key: string; label: string; href: string }>;
  active?: string;
}
const { variant, title, description, navigation, active = "home" } = Astro.props;
const homePath = templatePath(variant);
const navigationId = `${variant}-navigation`;
---

<header class="site-header">
  <div class="brand-row">
    <div class="site-name">
      <a class="logo" href={withBase(homePath)}>{title}</a>
      <p>{description}</p>
    </div>
    <div class="header-tools">
      {isCombinedSite && (
        <nav class="variant-switcher" aria-label="Template variant">
          <a class:list={{ active: variant === "blog" }} aria-current={variant === "blog" ? "page" : undefined} href={withBase(templatePath("blog"))}>Blog</a>
          <a class:list={{ active: variant === "academic" }} aria-current={variant === "academic" ? "page" : undefined} href={withBase(templatePath("academic"))}>Academic</a>
        </nav>
      )}
      <div class="utility-actions">
        {variant === "blog" && <a class="utility-link search-link" href={withBase(templatePath("blog", "/search/"))}><span aria-hidden="true">⌕</span><span class="sr-only">Search notes</span></a>}
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Use dark theme" aria-pressed="false">
          <span class="theme-light" aria-hidden="true">☼</span>
          <span class="theme-dark" aria-hidden="true">◐</span>
        </button>
        <button class="nav-toggle" type="button" data-nav-toggle aria-controls={navigationId} aria-expanded="false">
          <span aria-hidden="true">Menu</span>
          <span class="sr-only">Toggle navigation</span>
        </button>
      </div>
    </div>
  </div>
  <nav class="nav-menu" id={navigationId} data-nav-menu aria-label="Primary navigation">
    {navigation.map((item) => <a class:list={{ current: item.key === active }} aria-current={item.key === active ? "page" : undefined} href={withBase(templatePath(variant, item.href))}>{item.label}</a>)}
  </nav>
</header>
