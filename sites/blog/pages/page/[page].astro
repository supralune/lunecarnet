---
import { BlogHomePage, getBlogPagePaths, getPublishedPosts } from "@lunecarnet/astro";
import { blogTemplate } from "@/config/site";

export function getStaticPaths() { return getBlogPagePaths(blogTemplate.pagination?.postsPerPage); }
const posts = await getPublishedPosts();
const { currentPage } = Astro.props;
---
<BlogHomePage posts={posts} currentPage={currentPage} {...blogTemplate} />
