---
import { BlogHomePage, getBlogPagePaths, getPublishedPosts } from "@lunecarnet/astro";
import site from "../../config";

export function getStaticPaths() { return getBlogPagePaths(site.pagination?.postsPerPage); }
const posts = await getPublishedPosts();
const { currentPage } = Astro.props;
---
<BlogHomePage posts={posts} currentPage={currentPage} {...site} />
